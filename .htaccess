# Badagry Visitors Guide - Clean URL Rewrites & SEO Normalization
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Redirect: Physical index.html -> clean root /
  RewriteCond %{THE_REQUEST} \s/index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. Canonical Redirect: Direct access to /blog.php -> clean /blog/
  RewriteCond %{THE_REQUEST} \s/blog\.php[?\s] [NC]
  RewriteRule ^blog\.php$ /blog/ [R=301,L]

  # 3. Canonical Redirect: Direct access to /post.php?slug={slug} -> clean /blog/{slug}
  RewriteCond %{THE_REQUEST} \s/post\.php\?slug=([a-zA-Z0-9_-]+) [NC]
  RewriteRule ^post\.php$ /blog/%1? [R=301,L]

  # 4. Canonical Redirect: Enforce trailing slash for Blog Catalog (/blog -> /blog/)
  RewriteRule ^blog$ /blog/ [R=301,L]

  # 5. Canonical Redirect: Strip trailing slash for Blog Posts (/blog/{slug}/ -> /blog/{slug})
  RewriteRule ^blog/([a-zA-Z0-9_-]+)/+$ /blog/$1 [R=301,L]

  # 6. RSS & Atom Feeds Clean Route (/feed or /rss -> feed.xml)
  RewriteRule ^(feed|rss)/?$ feed.xml [L]

  # 7. Internal Rewrite: Blog Catalog /blog/ -> blog.php
  RewriteRule ^blog/$ blog.php [L,QSA]

  # 8. Internal Rewrite: Blog Post /blog/{slug} -> post.php?slug={slug}
  RewriteRule ^blog/([a-zA-Z0-9_-]+)$ post.php?slug=$1 [L,QSA]

  # 9. Clean Admin URL: /admin/? -> admin.php
  RewriteRule ^admin/?$ admin.php [L,QSA]

  # 10. Pass-through for existing physical files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 11. Hide .php extension for any other existing scripts
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>
